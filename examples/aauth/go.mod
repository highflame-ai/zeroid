// Interop and demo for ZeroID's AAuth Agent Provider (internal/aauth).
//
// A separate module on purpose: it depends on aauth-go, the reference
// implementation, which ZeroID's own module never imports. Run it with
// GOWORK=off from this directory (see README.md); it is not in go.work.
module github.com/highflame-ai/zeroid/examples/aauth

go 1.27.0

require (
	github.com/aauth-dev/aauth-go v0.3.1-0.20261026233316-ae3796e3d778
